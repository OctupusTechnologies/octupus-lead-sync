{
  "manifest_version": 3,
  "name": "Octupus Lead Sync",
  "version": "1.4.4",
  "description": "Envía leads del CRM de Odoo al portal de partners de odoo.com con un clic (origen Octupus), con nota de trazabilidad y sincronización de comentarios.",
  "permissions": ["storage", "cookies"],
  "host_permissions": ["https://*.odoo.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.odoo.com/*"],
      "js": ["src/bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Octupus Lead Sync"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  }
}
